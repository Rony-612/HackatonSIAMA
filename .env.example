# Asistente con IBM Granite (opcional). Sin nada de esto, el asistente responde con reglas deterministas.
GRANITE_PROVIDER=auto            # auto | watsonx | ollama | none

# Opción A: IBM watsonx.ai (nube)
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct   # confirma el id vigente en el catálogo de tu proyecto

# Opción B: Granite de pesos abiertos en local con Ollama (sin internet ni llaves)
# OLLAMA_MODEL=granite4:micro                # o el tag de Granite que tengas descargado (ollama list)
# OLLAMA_HOST=http://localhost:11434
